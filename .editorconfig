# EditorConfig settles indentation and whitespace before review has to.
# Reference: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Swift in this repository is indented with four spaces, as Xcode does.
[*.swift]
indent_size = 4

# Property lists and entitlements are written by Xcode with tabs.
[*.{plist,entitlements}]
indent_style = tab

# Markdown uses two trailing spaces as a hard line break, so trimming them
# silently changes the rendered output.
[*.md]
trim_trailing_whitespace = false

# YAML breaks on tabs. Being explicit costs one line.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab
